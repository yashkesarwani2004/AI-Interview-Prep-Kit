# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/ai_interview_prep

# Authentication
JWT_SECRET=super_secret_jwt_key_interview_prep_2026

# Configurable LLM Provider & Model Selection
LLM_PROVIDER=gemini # "gemini" | "groq" | "openai"
LLM_MODEL=gemini-1.5-flash

# API Keys (Provide at least one key with free tier access)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Local Crawler Evaluation Mode
# ALLOW_LOCAL_CRAWL=true enables crawling localhost/loopback URLs for batch evaluation
ALLOW_LOCAL_CRAWL=true
